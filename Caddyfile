{$DOMAIN} {
  encode zstd gzip

  @api path /api/*
  reverse_proxy @api backend:3001

  @feeds path /feeds/*
  reverse_proxy @feeds backend:3001

  @uploads path /uploads/*
  reverse_proxy @uploads backend:3001

  reverse_proxy frontend:80
}

{$FEED_DOMAIN} {
  encode zstd gzip

  # Feed-subdomein serveert uitsluitend de XML-feed; al het andere is 404.
  handle /feeds/* {
    reverse_proxy backend:3001
  }

  handle {
    respond 404
  }
}

# Publieke website (Astro, far-flare container op port 4321)
lightpersoneelsdiensten.nl {
  encode zstd gzip
  reverse_proxy far-flare:4321
}

www.lightpersoneelsdiensten.nl {
  redir https://lightpersoneelsdiensten.nl{uri} permanent
}
